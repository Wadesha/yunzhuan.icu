/**
 * app.wxss - 全局样式（黑白灰适配）
 * 设计基调：纯白底 / 纯黑字 / 中性灰分割
 */

page {
  --yz-black: #111111;
  --yz-gray-1: #555555;
  --yz-gray-2: #888888;
  --yz-gray-3: #cccccc;
  --yz-gray-4: #e0e0e0;
  --yz-gray-5: #f5f5f5;
  --yz-bg: #ffffff;
  --yz-warn: #cc0000;
  --yz-ok: #008800;
  background-color: var(--yz-bg);
  color: var(--yz-black);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
}

view, text, button, input, scroll-view {
  box-sizing: border-box;
}

.yz-container {
  padding: 24rpx 24rpx 64rpx;
}

.yz-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  color: var(--yz-black);
}

.yz-subtitle {
  font-size: 26rpx;
  color: var(--yz-gray-1);
  margin-bottom: 24rpx;
}

.yz-section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 32rpx 0 12rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid var(--yz-black);
  color: var(--yz-black);
}

.yz-card {
  border: 1rpx solid var(--yz-gray-4);
  padding: 20rpx 24rpx;
  background: var(--yz-bg);
  margin-bottom: 16rpx;
}

.yz-card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.yz-card-desc {
  font-size: 24rpx;
  color: var(--yz-gray-1);
  margin-bottom: 8rpx;
}

.yz-card-link {
  font-size: 24rpx;
  color: var(--yz-black);
  border-bottom: 1rpx solid var(--yz-gray-3);
  margin-right: 16rpx;
  display: inline-block;
}

.yz-badge {
  display: inline-block;
  border: 1rpx solid var(--yz-black);
  padding: 0 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--yz-black);
  margin-left: 6rpx;
}

.yz-badge-solid {
  background: var(--yz-black);
  color: var(--yz-bg);
}

.yz-muted {
  color: var(--yz-gray-2);
  font-size: 24rpx;
}

.yz-btn {
  display: inline-block;
  padding: 12rpx 28rpx;
  border: 1rpx solid var(--yz-black);
  background: var(--yz-bg);
  color: var(--yz-black);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.4;
}

.yz-btn-primary {
  background: var(--yz-black);
  color: var(--yz-bg);
}

.yz-btn[disabled] {
  opacity: 0.5;
}

.yz-divider {
  border-top: 1rpx solid var(--yz-gray-4);
  margin: 24rpx 0;
}

.yz-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.yz-grid > view {
  width: 50%;
  padding: 0 8rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.yz-grid-3 > view {
  width: 33.333%;
}

.yz-nav {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--yz-gray-4);
  font-size: 24rpx;
  color: var(--yz-gray-2);
  margin-bottom: 24rpx;
}

.yz-nav text {
  margin: 0 8rpx;
  color: var(--yz-gray-3);
}

.yz-footer {
  margin-top: 48rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--yz-gray-4);
  color: var(--yz-gray-2);
  font-size: 22rpx;
  text-align: center;
}

.yz-stat {
  display: flex;
  border: 1rpx solid var(--yz-gray-4);
  padding: 16rpx;
  margin-bottom: 12rpx;
  text-align: center;
}

.yz-stat > view {
  flex: 1;
}

.yz-stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--yz-black);
}

.yz-stat-label {
  font-size: 22rpx;
  color: var(--yz-gray-2);
  margin-top: 4rpx;
}
